---
interface Props {
	title: string;
	description?: string;
	image?: string;
}

const { 
	title, 
	description = "Dominate SERPs with EverRank. Plan content, spy on competitors, and optimize strategy with AI. The ultimate SEO content intelligence platform for modern creators.",
	image = "https://everrank.app/og-image.png"
} = Astro.props;

import TxchyaChat from '../components/TxchyaChat.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const totalArticles = allPosts.length;
---

<!doctype html>
<html lang="en">
	<head>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-NW863RZNTD"></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());

		  gtag('config', 'G-NW863RZNTD');
		</script>

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="https://everrank.app/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Metadata -->
		<title>{title} | EverRank Blog</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site || 'https://everrank.app')} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={`${title} | EverRank Blog`} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={`${title} | EverRank Blog`} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={image} />
		<meta name="twitter:creator" content="@everrankapp" />

		<!-- Per-page head injection (JSON-LD, extra meta, etc.) -->
		<slot name="head" />

		<!-- Feed Auto-Discovery -->
		<link rel="alternate" type="application/rss+xml" title="EverRank Blog — RSS Feed" href="https://everrank.app/blog/rss.xml" />
		<link rel="alternate" type="application/feed+json" title="EverRank Blog — JSON Feed" href="https://everrank.app/blog/feed.json" />
        
        <!-- Google Fonts matching main site -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

        <script is:inline>
            // Theme initialization script to prevent flicker
            (function() {
                // Must match the key used by next-themes in the main app
                const theme = localStorage.getItem('theme') || 'light';
                document.documentElement.setAttribute('data-theme', theme);
                if (theme === 'dark') {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
            })();
        </script>
	</head>
	<body>
		<div class="background-effects">
			<div class="blob blob-1"></div>
			<div class="blob blob-2"></div>
			<div class="grid-overlay"></div>
		</div>

		<header class="main-header">
			<nav class="nav-container">
				<div class="header-content-wrapper">
					<!-- Desktop Layout -->
					<div class="desktop-nav">
						<a href="https://everrank.app" class="logo">
							<img src="/logo.jpg" alt="EverRank" class="logo-img" />
							<span>EverRank</span>
						</a>

						<div class="nav-links-and-actions">
							<div class="nav-links-group">
								<div class="dropdown">
									<button class="dropdown-trigger">
										Categories <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 9 6 6 6-6"/></svg>
									</button>
									<div class="dropdown-menu">
										<a href="/blog/seo-fundamentals">SEO Fundamentals</a>
										<a href="/blog/ai-insights">AI + DraftIQ</a>
										<a href="/blog/tech-optimization">Tech Optimization</a>
										<a href="/blog/growth-systems">Growth Systems</a>
										<a href="/blog/best-practices">How-To Guides</a>
										<a href="/blog/case-studies">Case Studies</a>
									</div>
								</div>
								<a href="/blog" class="active">All Articles</a>
								<a href="https://everrank.app/pricing">Pricing</a>
								
								<div class="feed-links">
									<a href="/blog/rss.xml" title="RSS Feed"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"/></svg></a>
									<a href="/blog/feed.json" title="JSON Feed"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg></a>
								</div>
							</div>

							<div class="actions-group">
								<button id="theme-toggle" class="theme-toggle" aria-label="Toggle Theme">
									<svg class="sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42m12.72-12.72l1.42-1.42"/></svg>
									<svg class="moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
								</button>
								<a href="https://everrank.app/login" class="login-btn">Log In</a>
								<a href="https://everrank.app/register" class="cta-btn">Get Started</a>
							</div>
						</div>
					</div>

					<!-- Mobile Layout -->
					<div class="mobile-nav">
						<a href="https://everrank.app" class="logo">
							<img src="/logo.jpg" alt="EverRank" class="logo-img" />
							<span>EverRank</span>
						</a>

						<div class="mobile-actions">
							<button id="mobile-theme-toggle" class="theme-toggle" aria-label="Toggle Theme">
								<svg class="sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42m12.72-12.72l1.42-1.42"/></svg>
								<svg class="moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
							</button>
							<button id="mobile-menu-toggle" class="mobile-menu-toggle" aria-label="Open Menu">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
							</button>
						</div>
					</div>
				</div>

				<!-- Mobile Menu Overlay -->
				<div id="mobile-menu" class="mobile-menu">
					<div class="mobile-menu-content">
						<div class="mobile-menu-header">
							<a href="https://everrank.app" class="logo">
								<img src="/logo.jpg" alt="EverRank" class="logo-img" />
								<span>EverRank</span>
							</a>
							<button id="mobile-menu-close" class="close-btn">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
							</button>
						</div>
						<div class="mobile-nav-links">
							<div class="mobile-section">
								<span class="section-title">Categories</span>
								<a href="/blog/seo-fundamentals">SEO Fundamentals</a>
								<a href="/blog/ai-insights">AI + DraftIQ</a>
								<a href="/blog/tech-optimization">Tech Optimization</a>
								<a href="/blog/growth-systems">Growth Systems</a>
								<a href="/blog/best-practices">How-To Guides</a>
								<a href="/blog/case-studies">Case Studies</a>
							</div>
							<div class="mobile-section">
								<span class="section-title">Navigation</span>
								<a href="/blog">EverRank Blog</a>
								<a href="https://everrank.app/pricing">Pricing</a>
								<a href="https://everrank.app/login">Login to Dashboard</a>
							</div>
							<div class="mobile-section">
								<span class="section-title">Feeds</span>
								<div style="display: flex; gap: 24px;">
									<a href="/blog/rss.xml" class="feed-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"/></svg> RSS</a>
									<a href="/blog/feed.json" class="feed-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg> JSON</a>
								</div>
							</div>
							<a href="https://everrank.app/register" class="mobile-cta">Get Started Free</a>
						</div>
					</div>
				</div>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="main-footer">
			<div class="footer-container">
				<div class="footer-grid">
					<div class="footer-col brand-col">
						<a href="https://everrank.app" class="logo">
							<img src="/logo.jpg" alt="EverRank" class="logo-img" />
							<span>EverRank</span>
						</a>
						<p class="brand-desc">Empowering content creators with AI-driven intelligence to dominate search rankings.</p>
						<div class="footer-socials">
							<a href="https://x.com/everrankapp" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="X (Twitter)">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.045 4.126H5.078z"/></svg>
							</a>
							<a href="https://instagram.com/everrankapp" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Instagram">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
							</a>
							<a href="https://tiktok.com/@everrank" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="TikTok">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.04-.1z"/></svg>
							</a>
							<a href="https://github.com/GalaxyBuilt/everrank-blog" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="GitHub">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
							</a>
						</div>
					</div>
					<div class="footer-col">
						<h4>Product</h4>
						<div class="footer-links">
							<a href="https://everrank.app/#features">Features</a>
							<a href="https://everrank.app/pricing">Pricing</a>
							<a href="https://everrank.app/login">Log In</a>
							<a href="https://everrank.app/register">Sign Up</a>
						</div>
					</div>
					<div class="footer-col">
						<h4>Legal</h4>
						<div class="footer-links">
							<a href="https://everrank.app/legal/privacy">Privacy Policy</a>
							<a href="https://everrank.app/legal/terms">Terms of Use</a>
							<a href="https://everrank.app/legal/cookies">Cookie Policy</a>
						</div>
					</div>
				</div>
			</div>
			<div class="footer-bottom">
				<p>Engineered by <a href="https://galaxybuilt.dev" target="_blank" rel="noopener noreferrer">GalaxyBuilt</a> | {totalArticles} Articles Published</p>
			</div>
		</footer>

        <script>
            const themeBtn = document.getElementById('theme-toggle');
            const mobileThemeBtn = document.getElementById('mobile-theme-toggle');

            const handleThemeToggle = () => {
                const currentTheme = document.documentElement.getAttribute('data-theme');
                const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                
                document.documentElement.setAttribute('data-theme', newTheme);
                localStorage.setItem('theme', newTheme);
                
                if (newTheme === 'dark') {
                    document.documentElement.classList.add('dark');
                    document.documentElement.setAttribute('data-theme', 'dark');
                } else {
                    document.documentElement.classList.remove('dark');
                    document.documentElement.setAttribute('data-theme', 'light');
                }
            };

            themeBtn?.addEventListener('click', handleThemeToggle);
            mobileThemeBtn?.addEventListener('click', handleThemeToggle);
        </script>
        <TxchyaChat />
	</body>
</html>

<style is:global>
	:root {
		--primary-rgb: 102, 126, 234;
		--primary: rgb(var(--primary-rgb));
		--primary-hover: #5a6fd6;
		--accent: #764ba2;
		--gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
		
		/* Light Theme Tokens */
		--bg-rgb: 255, 255, 255;
		--bg: rgb(var(--bg-rgb));
		--bg-alt: #f8fafc;
		--text: #1e293b;
		--text-muted: #64748b;
		--border: #e2e8f0;
		--card-bg: #ffffff;
		--card-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
	}

	:root[data-theme="dark"], .dark {
		--bg-rgb: 17, 17, 17;
		--bg: rgb(var(--bg-rgb));
		--bg-alt: #1a1a1a;
		--text: #f1f5f9;
		--text-muted: #94a3b8;
		--border: #2e2e2e;
		--card-bg: #1a1a1a;
		--card-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.5);
	}
	
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html, body {
		background: var(--bg);
		color: var(--text);
		font-family: 'Outfit', 'Inter', system-ui, sans-serif;
		min-height: 100vh;
		overflow-x: hidden;
		transition: background 0.3s ease, color 0.3s ease;
	}

	/* Background Effects */
	.background-effects {
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
	}

	.blob {
		position: absolute;
		width: 60vw;
		height: 60vw;
		filter: blur(120px);
		border-radius: 50%;
		opacity: 0.08;
	}

	.blob-1 { top: -20%; left: -10%; background: var(--primary); }
	.blob-2 { bottom: -20%; right: -10%; background: var(--accent); }

	.grid-overlay {
		position: absolute;
		inset: 0;
		background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px);
		background-size: 50px 50px;
		opacity: 0.05;
	}

	/* Header Styling matching main site */
	.main-header {
		position: fixed;
		top: 0;
		width: 100%;
		z-index: 1000;
		background: #ffffff; /* Default light */
		border-bottom: 1px solid var(--border);
        transition: all 0.3s ease;
	}

    :root[data-theme="dark"] .main-header, .dark .main-header {
        background: #111111;
    }

	.nav-container {
		max-width: 1400px;
		margin: 0 auto;
		height: 72px;
		display: flex;
		align-items: center;
		padding: 0 24px;
        width: 100%;
	}

	.header-content-wrapper {
		width: 100%;
	}

	.desktop-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
	}

	.nav-links-and-actions {
		display: flex;
		align-items: center;
		gap: 32px;
	}

	.nav-links-group {
		display: flex;
		align-items: center;
		gap: 24px;
	}

	.nav-links-group a {
		text-decoration: none;
		color: var(--text-muted);
		font-size: 0.95rem;
		font-weight: 500;
		transition: all 0.2s ease;
	}

	.nav-links-group a:hover, .nav-links-group a.active {
		color: var(--primary);
	}

	.feed-links {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 0 12px;
		border-left: 1px solid var(--border);
	}

	.feed-links a {
		color: var(--text-muted);
		display: flex;
        transition: color 0.2s;
	}

    .feed-links a:hover {
        color: var(--primary);
    }

	.actions-group {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
		color: var(--text);
		font-weight: 800;
		font-size: 1.4rem;
		flex-shrink: 0;
	}

	.logo span {
		background: var(--gradient);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.logo-img {
		width: 32px;
		height: 32px;
		border-radius: 8px;
		object-fit: cover;
		display: block;
	}

	/* Dropdown Styles */
	.dropdown {
		position: relative;
		display: inline-block;
	}

	.dropdown-trigger {
		background: none;
		border: none;
		color: var(--text-muted);
		font-size: 0.95rem;
		font-weight: 500;
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 6px;
		font-family: inherit;
		transition: color 0.2s;
		padding: 8px 0;
	}

	.dropdown:hover .dropdown-trigger {
		color: var(--primary);
	}

	.dropdown-menu {
		position: absolute;
		top: 100%;
		left: 0;
		transform: translateY(10px);
		background: var(--bg); /* Solid */
		border: 1px solid var(--border);
		border-radius: 12px;
		width: 200px;
		padding: 8px;
		opacity: 0;
		visibility: hidden;
		transition: all 0.2s ease;
		box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1);
	}

	.dropdown:hover .dropdown-menu {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.dropdown-menu a {
		display: block;
		padding: 10px 12px;
		color: var(--text) !important;
		text-decoration: none;
		font-size: 0.9rem;
		border-radius: 6px;
	}

	.dropdown-menu a:hover {
		background: var(--bg-alt);
		color: var(--primary) !important;
	}

	.login-btn {
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 500;
		padding: 8px 12px;
        transition: color 0.2s;
	}

    .login-btn:hover {
        color: var(--primary);
    }

	.cta-btn {
		background: var(--gradient);
		color: white !important;
		padding: 10px 20px;
		border-radius: 8px;
		font-weight: 600 !important;
		text-decoration: none;
        transition: transform 0.2s;
	}

    .cta-btn:hover {
        transform: translateY(-1px);
    }

    .theme-toggle {
        background: var(--bg-alt);
        border: 1px solid var(--border);
        width: 40px;
        height: 40px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text);
        transition: all 0.3s ease;
        padding: 0;
    }

    .theme-toggle:hover {
        border-color: var(--primary);
    }

    /* Theme Toggle Icon Visibility */
    :root[data-theme="dark"] .theme-toggle .sun { display: block; }
    :root[data-theme="dark"] .theme-toggle .moon { display: none; }
    
    :root:not([data-theme="dark"]) .theme-toggle .sun { display: none; }
    :root:not([data-theme="dark"]) .theme-toggle .moon { display: block; }

	/* Mobile Styles */
	.mobile-nav {
		display: none;
		align-items: center;
		justify-content: space-between;
		width: 100%;
	}

	.mobile-actions {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.mobile-menu-toggle {
		background: var(--bg-alt);
		border: 1px solid var(--border);
		width: 40px;
		height: 40px;
		border-radius: 50%;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text);
	}

	@media (max-width: 1100px) {
		.desktop-nav { display: none; }
		.mobile-nav { display: flex; }
	}

    .mobile-menu {
        position: fixed;
        inset: 0;
        z-index: 2000;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(8px);
