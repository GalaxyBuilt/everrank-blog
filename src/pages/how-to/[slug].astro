---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { format } from 'date-fns';

export const prerender = true;

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data, id }) => {
    // Return posts that are in the how-to directory and aren't drafts
    return data.draft !== true && id.includes('how-to/');
  });

  return allPosts.map(post => {
    return {
      params: { 
        slug: post.slug.split('/').pop() // Ensure just the basename maps to the URL
      },
      props: { post, allPosts }
    };
  });
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await post.render();

const postImage = post.data.image ? post.data.image.src : `https://everrank.app/og-image.png`;

// JSON-LD Article schema
const siteBase = 'https://everrank.app';
const canonicalUrl = `${siteBase}/blog/how-to/${post.slug.split('/').pop()}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "image": postImage,
  "url": canonicalUrl,
  "datePublished": post.data.date.toISOString(),
  "dateModified": post.data.date.toISOString(),
  "author": {
    "@type": "Person",
    "name": post.data.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "EverRank",
    "logo": { "@type": "ImageObject", "url": `${siteBase}/favicon.ico` }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
  "keywords": post.data.tags.join(', ')
};
---

<Layout 
  title={`${post.data.title} | EverRank Intelligence`} 
  description={post.data.description}
  image={postImage}
>
  <!-- JSON-LD Structured Data -->
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <!-- Reading Progress Bar -->
  <div id="progress-bar" class="progress-bar"></div>

  <div class="article-container">
    <nav class="breadcrumb">
        <a href="/blog">Hub</a>
        <span>/</span>
        <a href={`/blog`}>How-To Guides</a>
        <span>/</span>
        <span class="curr">{post.data.title}</span>
    </nav>

    <div class="layout-grid">
      <article class="luxe-article">
          <header class="article-header">
              <div class="category-badge">{post.data.category}</div>
              <h1>{post.data.title}</h1>
              <div class="article-meta">
                  <span>{post.data.author}</span>
                  <span class="dot"></span>
                  <time datetime={post.data.date.toISOString()}>
                    {format(post.data.date, 'MMMM d, yyyy')}
                  </time>
              </div>
          </header>

          <div class="article-content prose">
              <p class="lead">{post.data.description}</p>
              <Content />
          </div>

          <footer class="article-footer">
              <div class="tags">
                {post.data.tags.map((tag: string) => (
                  <span class="tag">#{tag}</span>
                ))}
              </div>

              <div class="post-cta">
                  <h3>Outrank Your Competitors with AI</h3>
                  <p>Stop guessing what Google wants. Use EverRank's ContentIQ Engine to reverse-engineer the SERPs and build compounding authority.</p>
                  <a href="https://everrank.app/register" class="cta-btn">Start Free Trial</a>
              </div>
          </footer>
      </article>

      <!-- Sidebar -->
      <aside class="article-sidebar desktop-only">
        {headings.length > 0 && (
          <div class="toc-container">
            <h3>Table of Contents</h3>
            <ul class="toc-list">
              {headings.map((heading: any) => (
                <li class={`depth-${heading.depth}`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </div>
</Layout>

<script>
  window.addEventListener('scroll', () => {
    const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const scrolled = (winScroll / height) * 100;
    const bar = document.getElementById('progress-bar');
    if (bar) bar.style.width = scrolled + '%';
  });
</script>

<style>
  .progress-bar {
    position: fixed;
    top: 72px; /* Header height */
    left: 0;
    width: 0%;
    height: 3px;
    background: var(--gradient);
    z-index: 999;
    transition: width 0.1s ease;
  }

  .article-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 120px 24px 80px;
  }

  .breadcrumb {
    display: flex;
    gap: 12px;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 40px;
    text-transform: capitalize;
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover { color: var(--primary); }
  .breadcrumb .curr { color: var(--text); font-weight: 600; text-transform: capitalize; }

  .layout-grid {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 64px;
    align-items: start;
  }

  .luxe-article {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 32px;
    padding: 60px;
    box-shadow: var(--card-shadow);
  }

  .article-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .category-badge {
    display: inline-block;
    background: rgba(102, 126, 234, 0.1);
    color: var(--primary);
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 16px;
    border: 1px solid rgba(102, 126, 234, 0.2);
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 24px;
    letter-spacing: -0.02em;
  }

  .article-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .article-meta span:first-child {
    font-weight: 600;
    color: var(--text);
  }

  .dot { width: 4px; height: 4px; background: var(--border); border-radius: 50%; }

  /* Prose Styles */
  .article-content {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--text);
  }

  .lead { 
    font-size: 1.3rem; 
    margin-bottom: 40px; 
    font-weight: 500; 
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    padding-bottom: 40px;
  }

  .prose :global(h2) { font-size: 2rem; margin: 60px 0 24px; font-weight: 800; letter-spacing: -0.02em; }
  .prose :global(h3) { font-size: 1.5rem; margin: 40px 0 16px; font-weight: 700; }
  .prose :global(p) { margin-bottom: 24px; }
  .prose :global(ul), .prose :global(ol) { margin-bottom: 32px; padding-left: 24px; }
  .prose :global(li) { margin-bottom: 12px; }
  .prose :global(li::marker) { color: var(--primary); }
  .prose :global(a) { color: var(--primary); text-decoration: none; border-bottom: 1px solid transparent; transition: border-color 0.2s; }
  .prose :global(a:hover) { border-bottom-color: var(--primary); }
  
  .prose :global(blockquote) { 
    border-left: 4px solid var(--primary); 
    padding: 24px 32px; 
    font-style: italic; 
    background: var(--bg-alt);
    border-radius: 0 16px 16px 0;
    color: var(--text); 
    margin: 40px 0; 
    font-size: 1.25rem;
    line-height: 1.6;
  }

  .prose :global(img) { 
    max-width: 100%; 
    height: auto; 
    border-radius: 16px; 
    margin: 40px 0; 
    box-shadow: var(--card-shadow); 
    border: 1px solid var(--border); 
  }

  .prose :global(pre) { 
    background: #1a1b26; 
    padding: 24px; 
    border-radius: 12px; 
    overflow-x: auto; 
    margin: 32px 0; 
    font-size: 0.95rem; 
  }
  
  .prose :global(code) { 
    font-family: 'Fira Code', monospace; 
    background: var(--bg-alt); 
    padding: 4px 6px; 
    border-radius: 6px; 
    font-size: 0.9em; 
    color: var(--primary);
  }
  
  .prose :global(pre code) { background: transparent; padding: 0; color: #e0af68; }

  /* Footer & CTA */
  .article-footer {
    margin-top: 60px;
    padding-top: 40px;
    border-top: 1px solid var(--border);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 40px;
  }

  .tag {
    background: var(--bg-alt);
    border: 1px solid var(--border);
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .post-cta {
    background: linear-gradient(to bottom right, var(--bg-alt), rgba(102, 126, 234, 0.05));
    border: 1px solid var(--primary);
    padding: 40px;
    border-radius: 20px;
    text-align: center;
  }

  .post-cta h3 { font-size: 1.5rem; margin-bottom: 12px; font-weight: 800; }
  .post-cta p { color: var(--text-muted); font-size: 1rem; margin-bottom: 24px; }
  
  .cta-btn {
    display: inline-block;
    background: var(--primary);
    color: white;
    padding: 12px 24px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 700;
  }

  /* Sidebar TOC */
  .article-sidebar {
    position: sticky;
    top: 120px;
  }

  .toc-container {
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 24px;
  }

  .toc-container h3 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-muted);
    margin-bottom: 16px;
    font-weight: 700;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .toc-list li { margin: 0; }
  .toc-list .depth-2 { padding-left: 0; font-weight: 600; }
  .toc-list .depth-3 { padding-left: 16px; font-size: 0.9rem; }
  .toc-list .depth-4 { padding-left: 32px; font-size: 0.85rem; }

  .toc-list a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
    line-height: 1.4;
    display: block;
  }

  .toc-list a:hover { color: var(--primary); }

  @media (max-width: 1024px) {
    .layout-grid { grid-template-columns: 1fr; }
    .desktop-only { display: none; }
  }

  @media (max-width: 768px) {
    .article-container { padding-top: 100px; }
    .luxe-article { padding: 40px 24px; }
    h1 { font-size: 2.2rem; }
  }
</style>
