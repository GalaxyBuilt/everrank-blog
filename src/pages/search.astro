---
import Layout from '../layouts/Layout.astro';

const siteBase = 'https://everrank.app';
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SearchResultsPage",
  "name": "EverRank Blog Search",
  "url": `${siteBase}/blog/search`,
};
---

<Layout
  title="Search"
  description="Search the EverRank Blog — find articles on SEO, AI insights, Core Web Vitals, content strategy, and more."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="search-page">
    <div class="search-hero">
      <p class="search-label">Intelligence Search</p>
      <h1>Find What You Need</h1>
      <p class="search-subtitle">Search across all articles, insights, and guides.</p>

      <div class="search-bar-wrapper">
        <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <input
          id="search-input"
          type="search"
          placeholder="Search articles, topics, tags..."
          class="search-input"
          autocomplete="off"
          spellcheck="false"
          aria-label="Search blog posts"
        />
        <kbd class="search-shortcut" id="search-shortcut">ESC</kbd>
      </div>

      <div id="search-filters" class="filter-row" style="display:none;">
        <span class="filter-label">Filter by pillar:</span>
        <div class="filter-chips" id="filter-chips"></div>
      </div>
    </div>

    <!-- Results / Default State -->
    <div class="search-results-wrapper">
      <div id="search-meta" class="search-meta" style="display:none;"></div>

      <div id="results-grid" class="results-grid"></div>

      <div id="empty-state" class="empty-state" style="display:none;">
        <div class="empty-icon">🔍</div>
        <h3>No results found</h3>
        <p>Try a different keyword or browse by pillar below.</p>
      </div>

      <div id="default-state" class="default-state">
        <h2 class="browse-title">Browse by Topic</h2>
        <div class="pillar-list" id="pillar-list"></div>
      </div>
    </div>
  </div>
</Layout>

<script>
  type Post = {
    title: string;
    description: string;
    author: string;
    pillar: string;
    category: string;
    tags: string[];
    date: string;
    url: string;
    searchText: string;
  };

  let allPosts: Post[] = [];
  let activePillar: string | null = null;

  // ─── Fetch index ───────────────────────────────────────────────
  async function loadIndex() {
    const res = await fetch('/blog/search.json');
    allPosts = await res.json();
    buildPillarList();
    checkURLQuery();
  }

  // ─── Pillar chips + default browse ─────────────────────────────
  function buildPillarList() {
    const pillars = [...new Set(allPosts.map(p => p.pillar))];
    const counts: Record<string, number> = {};
    allPosts.forEach(p => { counts[p.pillar] = (counts[p.pillar] || 0) + 1; });

    // Pillar filter chips (shown during search)
    const chipsEl = document.getElementById('filter-chips')!;
    chipsEl.innerHTML = `<button class="chip active" data-pillar="">All</button>` +
      pillars.map(p => `<button class="chip" data-pillar="${p}">${p.replace(/-/g, ' ')} <span class="chip-count">${counts[p]}</span></button>`).join('');
    chipsEl.querySelectorAll('.chip').forEach(btn => {
      btn.addEventListener('click', () => {
        activePillar = (btn as HTMLButtonElement).dataset.pillar || null;
        chipsEl.querySelectorAll('.chip').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        doSearch((document.getElementById('search-input') as HTMLInputElement).value);
      });
    });

    // Default browse pillars
    const pillarList = document.getElementById('pillar-list')!;
    const pillarIcons: Record<string, string> = {
      'seo-fundamentals': '🎯',
      'ai-insights': '🤖',
      'tech-optimization': '⚡',
      'growth-systems': '📈',
      'best-practices': '📚',
      'case-studies': '🏆',
    };
    pillarList.innerHTML = pillars.map(p => `
      <a href="/blog/${p}" class="pillar-browse-card">
        <span class="pillar-emoji">${pillarIcons[p] || '📄'}</span>
        <div>
          <strong>${p.replace(/-/g, ' ')}</strong>
          <span class="pillar-count">${counts[p]} article${counts[p] !== 1 ? 's' : ''}</span>
        </div>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
      </a>
    `).join('');
  }

  // ─── Search logic ────────────────────────────────────────────
  function doSearch(query: string) {
    const q = query.trim().toLowerCase();
    const resultsGrid = document.getElementById('results-grid')!;
    const emptyState = document.getElementById('empty-state')!;
    const defaultState = document.getElementById('default-state')!;
    const searchMeta = document.getElementById('search-meta')!;
    const searchFilters = document.getElementById('search-filters')!;

    if (!q) {
      resultsGrid.innerHTML = '';
      emptyState.style.display = 'none';
      defaultState.style.display = 'block';
      searchMeta.style.display = 'none';
      searchFilters.style.display = 'none';
      activePillar = null;
      document.querySelectorAll('.chip').forEach(b => b.classList.remove('active'));
      document.querySelector('.chip[data-pillar=""]')?.classList.add('active');
      return;
    }

    defaultState.style.display = 'none';
    searchFilters.style.display = 'flex';

    let results = allPosts.filter(p => p.searchText.includes(q));
    if (activePillar) results = results.filter(p => p.pillar === activePillar);

    searchMeta.style.display = 'block';
    searchMeta.textContent = `${results.length} result${results.length !== 1 ? 's' : ''} for "${query}"${activePillar ? ` in ${activePillar.replace(/-/g, ' ')}` : ''}`;

    if (results.length === 0) {
      resultsGrid.innerHTML = '';
      emptyState.style.display = 'flex';
      return;
    }

    emptyState.style.display = 'none';
    resultsGrid.innerHTML = results.map(post => `
      <a href="${post.url}" class="result-card">
        <div class="result-meta">
          <span class="result-pillar">${post.pillar.replace(/-/g, ' ')}</span>
          <span class="result-date">${post.date}</span>
        </div>
        <h3 class="result-title">${highlight(post.title, q)}</h3>
        <p class="result-desc">${highlight(post.description, q)}</p>
        <div class="result-tags">
          ${post.tags.slice(0, 4).map(t => `<span class="result-tag">${t}</span>`).join('')}
        </div>
      </a>
    `).join('');
  }

  function highlight(text: string, query: string): string {
    if (!query) return text;
    const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    return text.replace(new RegExp(`(${escaped})`, 'gi'), '<mark>$1</mark>');
  }

  // ─── Wire input ───────────────────────────────────────────────
  function checkURLQuery() {
    const params = new URLSearchParams(window.location.search);
    const q = params.get('q') || '';
    const input = document.getElementById('search-input') as HTMLInputElement;
    if (q) { input.value = q; doSearch(q); }
    input.focus();
  }

  const input = document.getElementById('search-input') as HTMLInputElement;
  let debounceTimer: ReturnType<typeof setTimeout>;
  input?.addEventListener('input', (e) => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      const q = (e.target as HTMLInputElement).value;
      doSearch(q);
      const url = new URL(window.location.href);
      if (q) { url.searchParams.set('q', q); } else { url.searchParams.delete('q'); }
      history.replaceState(null, '', url.toString());
    }, 200);
  });

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { input.value = ''; doSearch(''); }
  });

  loadIndex();
</script>

<style>
  .search-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 120px 24px 80px;
  }

  /* Hero */
  .search-hero { text-align: center; margin-bottom: 56px; }
  .search-label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--primary);
    margin-bottom: 16px;
  }
  h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 12px;
  }
  .search-subtitle { color: var(--text-muted); font-size: 1.1rem; margin-bottom: 40px; }

  /* Search bar */
  .search-bar-wrapper {
    position: relative;
    max-width: 640px;
    margin: 0 auto 24px;
  }
  .search-icon {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
  }
  .search-input {
    width: 100%;
    padding: 18px 56px 18px 52px;
    background: var(--card-bg);
    border: 1.5px solid var(--border);
    border-radius: 16px;
    color: var(--text);
    font-size: 1.1rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 24px -8px rgba(0,0,0,0.15);
  }
  .search-input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 4px rgba(102,126,234,0.12);
  }
  .search-shortcut {
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.7rem;
    font-family: monospace;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    padding: 3px 8px;
    border-radius: 6px;
    color: var(--text-muted);
  }

  /* Filter chips */
  .filter-row {
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 8px;
  }
  .filter-label { font-size: 0.85rem; color: var(--text-muted); font-weight: 600; }
  .filter-chips { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .chip {
    padding: 6px 14px;
    border-radius: 20px;
    border: 1px solid var(--border);
    background: var(--bg-alt);
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    text-transform: capitalize;
    transition: all 0.2s;
  }
  .chip:hover { border-color: var(--primary); color: var(--primary); }
  .chip.active { background: var(--primary); border-color: var(--primary); color: white; }
  .chip-count { opacity: 0.7; margin-left: 2px; }

  /* Meta */
  .search-meta {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  /* Results grid */
  .results-grid { display: flex; flex-direction: column; gap: 16px; }
  .result-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 24px 28px;
    text-decoration: none;
    color: var(--text);
    display: block;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .result-card:hover {
    border-color: var(--primary);
    transform: translateX(4px);
    box-shadow: -4px 0 0 0 var(--primary);
  }
  .result-meta { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
  .result-pillar {
    font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: var(--primary);
  }
  .result-date { font-size: 0.78rem; color: var(--text-muted); }
  .result-title { font-size: 1.15rem; font-weight: 700; margin-bottom: 8px; line-height: 1.4; }
  .result-desc { color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; margin-bottom: 12px; }
  .result-tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .result-tag {
    font-size: 0.75rem; background: var(--bg-alt); border: 1px solid var(--border);
    padding: 3px 10px; border-radius: 6px; color: var(--text-muted);
  }

  /* Highlight */
  :global(mark) {
    background: rgba(102, 126, 234, 0.2);
    color: var(--primary);
    border-radius: 3px;
    padding: 0 2px;
    font-weight: 700;
  }

  /* Empty state */
  .empty-state {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 24px;
    text-align: center;
    gap: 12px;
    color: var(--text-muted);
  }
  .empty-icon { font-size: 3rem; }
  .empty-state h3 { font-size: 1.4rem; color: var(--text); margin: 0; }
  .empty-state p { margin: 0; }

  /* Default browse state */
  .browse-title { font-size: 1.4rem; font-weight: 800; margin-bottom: 20px; }
  .pillar-list { display: flex; flex-direction: column; gap: 12px; }
  .pillar-browse-card {
    display: flex;
    align-items: center;
    gap: 16px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 18px 24px;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.2s, transform 0.2s;
  }
  .pillar-browse-card:hover { border-color: var(--primary); transform: translateX(4px); }
  .pillar-emoji { font-size: 1.6rem; flex-shrink: 0; }
  .pillar-browse-card div { flex: 1; }
  .pillar-browse-card strong { display: block; font-weight: 700; text-transform: capitalize; font-size: 1rem; }
  .pillar-count { font-size: 0.82rem; color: var(--text-muted); }
  .pillar-browse-card svg { color: var(--text-muted); flex-shrink: 0; }
</style>
