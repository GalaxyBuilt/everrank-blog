---
/**
 * TxchyaChat.astro
 * Floating cyberpunk AI assistant widget for EverRank Blog.
 */
---

<div id="txchya-wrapper">
  <!-- Chat Bubble -->
  <button id="txchya-bubble" aria-label="Talk to Txchya">
    <div class="bubble-glow"></div>
    <img src="/logo.jpg" alt="Txchya" />
    <div class="pulse-ring"></div>
  </button>

  <!-- Chat Window -->
  <div id="txchya-window">
    <!-- Header -->
    <div class="chat-header">
      <div class="header-main">
        <div class="avatar-ring">
          <img src="/logo.jpg" alt="Txchya" />
        </div>
        <div>
          <h3 class="status-title">Txchya OS</h3>
          <div class="status-indicator">
            <span class="status-dot"></span>
            <span class="status-text">EverRank Node Active</span>
          </div>
        </div>
      </div>
      <button id="txchya-close">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <!-- Chat Messages -->
    <div id="txchya-messages">
      <div class="msg-wrapper align-start">
        <div class="txchya-bubble">
          <b>Txchya:</b> Booting up... Systems online. How can I assist you with your SEO research today?
        </div>
      </div>
    </div>

    <!-- Input Area -->
    <div class="input-area">
      <div class="input-container">
        <input type="text" id="txchya-input" placeholder="Type a message..." />
        <button id="txchya-send" disabled>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  #txchya-wrapper {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    font-family: inherit;
  }

  #txchya-bubble {
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: black;
    border: 2px solid #667eea;
    box-shadow: 0 0 20px rgba(102, 126, 234, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s;
    overflow: hidden;
    padding: 0;
  }

  #txchya-bubble:hover {
    transform: scale(1.1);
  }

  #txchya-bubble:active {
    transform: scale(0.95);
  }

  #txchya-bubble img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .bubble-glow {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(102,126,234,0.2), transparent);
    opacity: 0;
    transition: opacity 0.3s;
  }

  #txchya-bubble:hover .bubble-glow {
    opacity: 1;
  }

  .pulse-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid #667eea;
    animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
    opacity: 0.2;
  }

  @keyframes ping {
    75%, 100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  #txchya-window {
    position: absolute;
    bottom: 80px;
    right: 0;
    width: 380px;
    height: 520px;
    background: rgba(10, 10, 10, 0.95);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(102, 126, 234, 0.3);
    border-radius: 20px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9);
    display: flex;
    flex-direction: column;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    transform: translateY(20px);
    opacity: 0;
    pointer-events: none;
    overflow: hidden;
  }

  @media (max-width: 450px) {
    #txchya-window {
      width: calc(100vw - 48px);
      height: 70vh;
    }
  }

  #txchya-window.open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .chat-header {
    padding: 16px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: linear-gradient(90deg, rgba(102, 126, 234, 0.1), transparent);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .header-main {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .avatar-ring {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: black;
    border: 1px solid #667eea;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .avatar-ring img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .status-title {
    color: #667eea;
    font-weight: 700;
    font-size: 0.9rem;
    margin: 0;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background: #667eea;
    border-radius: 50%;
    animation: blink 2s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }

  .status-text {
    font-size: 10px;
    color: rgba(102, 126, 234, 0.6);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  #txchya-close {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.4);
    cursor: pointer;
    transition: color 0.2s;
    padding: 4px;
  }

  #txchya-close:hover {
    color: white;
  }

  #txchya-messages {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    scroll-behavior: smooth;
  }

  #txchya-messages::-webkit-scrollbar { width: 4px; }
  #txchya-messages::-webkit-scrollbar-thumb { background: #333; border-radius: 10px; }

  .msg-wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .align-start { align-items: flex-start; }
  .align-end { align-items: flex-end; }

  .txchya-bubble, .user-bubble {
    max-width: 85%;
    padding: 12px 16px;
    font-size: 0.9rem;
    line-height: 1.5;
    border-radius: 16px;
  }

  .txchya-bubble {
    background: linear-gradient(135deg, #0d0d0d 0%, #1a1a1a 100%);
    color: #667eea;
    border: 1px solid rgba(102, 126, 234, 0.2);
    border-top-left-radius: 2px;
  }

  .user-bubble {
    background: #222;
    color: #eee;
    border: 1px solid #333;
    border-top-right-radius: 2px;
  }

  .input-area {
    padding: 16px 20px;
    background: #000;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .input-container {
    position: relative;
    display: flex;
    align-items: center;
  }

  #txchya-input {
    width: 100%;
    background: #111;
    border: 1px solid #333;
    color: white;
    padding: 12px 48px 12px 16px;
    border-radius: 12px;
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s;
  }

  #txchya-input:focus {
    border-color: #667eea;
  }

  #txchya-send {
    position: absolute;
    right: 8px;
    background: none;
    border: none;
    color: #667eea;
    cursor: pointer;
    transition: transform 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
  }

  #txchya-send:hover:not(:disabled) {
    transform: scale(1.1);
  }

  #txchya-send:disabled {
    opacity: 0.3;
    cursor: default;
  }
</style>

<script>
  const BACKEND_URL = 'https://txchya.com/api/chat';

  const bubble = document.getElementById('txchya-bubble');
  const window_el = document.getElementById('txchya-window');
  const closeBtn = document.getElementById('txchya-close');
  const input = document.getElementById('txchya-input') as HTMLInputElement;
  const sendBtn = document.getElementById('txchya-send') as HTMLButtonElement;
  const messagesBox = document.getElementById('txchya-messages');

  function toggleChat() {
    window_el?.classList.toggle('open');
    if (window_el?.classList.contains('open')) {
      input?.focus();
    }
  }

  bubble?.addEventListener('click', toggleChat);
  closeBtn?.addEventListener('click', () => window_el?.classList.remove('open'));

  input?.addEventListener('input', () => {
    if (sendBtn) sendBtn.disabled = !input.value.trim();
  });

  async function sendMessage() {
    if (!input || !sendBtn) return;
    const text = input.value.trim();
    if (!text) return;

    appendMessage('You', text, 'user-bubble', 'end');
    input.value = '';
    sendBtn.disabled = true;
    
    const loadingId = appendMessage('Txchya', '...', 'txchya-bubble', 'start');

    try {
      const response = await fetch(BACKEND_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
          message: text,
          site: window.location.hostname + ' (EverRank Blog)'
        })
      });
      
      const data = await response.json();
      if (data.reply) {
        updateMessage(loadingId, data.reply);
      } else {
        updateMessage(loadingId, data.error || 'The neural link is flickering. Systems unstable.');
      }
    } catch (err) {
      updateMessage(loadingId, 'Connection link unstable. Please retry, Operator.');
    }
    
    if (sendBtn) sendBtn.disabled = !input.value.trim();
  }

  function appendMessage(sender: string, text: string, classes: string, align: 'start' | 'end') {
    const id = 'txchya-msg-' + Date.now();
    const wrapper = document.createElement('div');
    wrapper.className = `msg-wrapper align-${align}`;
    
    const bubble = document.createElement('div');
    bubble.id = id;
    bubble.className = classes;
    
    const label = document.createElement('b');
    label.textContent = `${sender}: `;
    bubble.appendChild(label);
    
    const content = document.createElement('span');
    content.textContent = text;
    bubble.appendChild(content);
    
    wrapper.appendChild(bubble);
    messagesBox?.appendChild(wrapper);
    
    if (messagesBox) messagesBox.scrollTop = messagesBox.scrollHeight;
    return id;
  }

  function updateMessage(id: string, text: string) {
    const el = document.getElementById(id);
    if (el) {
      const label = el.querySelector('b');
      const content = el.querySelector('span');
      if (content) content.textContent = text;
      if (messagesBox) messagesBox.scrollTop = messagesBox.scrollHeight;
    }
  }

  sendBtn?.addEventListener('click', sendMessage);
  input?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') sendMessage();
  });
</script>
